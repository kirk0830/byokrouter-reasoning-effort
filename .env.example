# ============================================================================
#  byokrouter-reasoning-effort -- configuration template
#
#  Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#  Only UPSTREAM_URL and UPSTREAM_API_KEY have no sensible default.
# ============================================================================

# --- upstream gateway -------------------------------------------------------
# The OpenAI-compatible endpoint that serves your models.
# Use the ORIGIN only (no /chat/completions): the proxy appends the path.
UPSTREAM_URL=https://your-gateway.example.com

# An OpenAI-compatible key. Alternatively point REASONING_PROXY_KEYS at a
# gitignored JSON file: { "default": "<key>", "models": { "<id>": "<key>" } }
UPSTREAM_API_KEY=

# --- listen -----------------------------------------------------------------
# 127.0.0.1 is safe and sufficient IF your client calls the model from this
# machine. Several clients do not - see docs/why-a-proxy.md first.
REASONING_PROXY_BIND=127.0.0.1
REASONING_PROXY_PORT=8798

# --- client authentication --------------------------------------------------
# REQUIRED whenever BIND is not loopback, otherwise anyone who can reach the
# port can spend your gateway credits. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
REASONING_PROXY_CLIENT_TOKEN=

# Extra token for the loopback-only admin API (/_status, /_control).
REASONING_PROXY_ADMIN_TOKEN=

# 1 = remove the admin endpoints entirely.
REASONING_PROXY_NO_ADMIN=

# --- source allowlist -------------------------------------------------------
# Comma-separated addresses or prefixes allowed to use the proxy. Start empty,
# collect real traffic, then set it. Judged on x-forwarded-for when
# REASONING_PROXY_TRUST_FORWARDED=1 (needed when NAT hides the caller).
REASONING_PROXY_ALLOWLIST=
REASONING_PROXY_ALLOWLIST_STRICT=
REASONING_PROXY_TRUST_FORWARDED=

# --- behaviour --------------------------------------------------------------
# Reasoning tiers live in byokrouter.json (committable, supports ${VAR} refs).
REASONING_PROXY_QUIET=
